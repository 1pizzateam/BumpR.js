{
  "name": "@1pizzateam/bumpr",
  "version": "1.0.0",
  "description": "2D physics engine written in TypeScript",
  "keywords": [
    "physics",
    "physics-engine",
    "2d-physics",
    "collision-detection",
    "aabb",
    "circle-collision",
    "typescript"
  ],
  "homepage": "https://github.com/1pizzateam/BumpR.js",
  "type": "module",
  "sideEffects": false,
  "main": "dist/bumpr.js",
  "types": "dist/bumpr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bumpr.d.ts",
      "import": "./dist/bumpr.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1pizzateam/BumpR.js.git"
  },
  "bugs": {
    "url": "https://github.com/1pizzateam/BumpR.js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber",
    "email": "http://www.lcluber.com/contact",
    "url": "http://www.lcluber.com/"
  },
  "contributors": [],
  "scripts": {
    "prebuild": "npm install",
    "build": "npm run build:lib && npm run test",
    "build:lib": "node ./scripts/clear.js && tsc && npm run rollup && node ./scripts/copy.js",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@1pizzateam/spock": "4.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.4.1",
    "jest": "29.7.0",
    "rollup": "4.63.1",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "6.0.3"
  }
}
